{
  "H1": "margin:60px 0 50px;text-align:center;display:inline-block;font-size:24px;font-weight:normal;color:#1A261D;padding:12px 24px;border:1px solid #739072;border-radius:2px;background-color:#F1F4F0;letter-spacing:2px;",
  "H2": "margin:50px 0 24px;text-align:left;border-bottom:1px solid #E8EBE9;padding-bottom:10px;display:inline-block;font-size:19px;font-weight:700;color:#4F6F52;padding-left:12px;border-left:5px solid #4F6F52;line-height:1.2;letter-spacing:1px;",
  "H3": "margin:40px 0 20px;text-align:center;font-size:17px;font-weight:bold;color:#739072;display:inline-block;border-bottom:2px dotted #739072;padding-bottom:4px;",
  "H4": "margin:30px 0 15px;text-align:left;display:inline-block;font-size:15px;font-weight:700;color:#fff;background-color:#86A789;padding:4px 10px;border-radius:4px;line-height:1.4;",
  "P": "margin:26px 0;line-height:2.0;letter-spacing:0.5px;text-align:justify;color:#3A4D39;font-size:16px;",
  "BLOCKQUOTE": "margin:36px 0;padding:24px;background-color:#F6F8F6;border:1px dashed #739072;border-radius:8px;",
  "BLOCKQUOTE P": "margin:0;color:#556B58;font-size:15px;line-height:1.8;font-family:'KaiTi','STKaiti',serif;",
  "UL": "margin:20px 0;padding-left:20px;list-style-type:disc;color:#86A789;",
  "OL": "margin:20px 0;padding-left:20px;list-style-type:decimal;color:#4F6F52;font-weight:bold;",
  "LI": "margin-bottom:12px;line-height:1.8;color:#3A4D39;font-size:16px;font-weight:normal;",
  "A": "color:#4F6F52;text-decoration:none;border-bottom:1px solid #4F6F52;font-weight:600;padding-bottom:0px;",
  "STRONG": "color:#1A261D;font-weight:700;background:linear-gradient(to top, rgba(134,167,137,0.4) 50%, transparent 50%);margin:0 2px;padding:0 2px;",
  "EM": "color:#739072;font-style:italic;",
  "EM STRONG": "color:#4F6F52;",
  "STRONG EM": "color:#4F6F52;",
  "MARK": "background:linear-gradient(to top, rgba(134,167,137,0.3) 50%, transparent 50%);color:#1A261D;padding:0 2px;",
  "DEL": "text-decoration:line-through;color:#889E8B;",
  "CODE": "color:#4F6F52;background:#EDF1EE;border:none;padding:3px 6px;margin:0 4px;border-radius:4px;font-size:14px;font-family:sans-serif;",
  "PRE": "display:block;padding:20px;background:#F0F2F0;color:#3A4D39;font-size:13px;line-height:1.6;border-radius:6px;font-family:sans-serif;overflow-x:auto;white-space:pre-wrap;word-break:break-all;border:1px solid #DCE3DD;",
  "IMG": "display:block;margin:40px auto;width:100%;border-radius:2px;box-shadow:0 8px 20px rgba(79,111,82,0.15);padding:6px;background:#fff;border:1px solid #eee;",
  "HR": "margin:60px auto;border:none;height:1px;background-color:#D2D4D4;width:60%;",
  "TABLE": "width:100%;border-collapse:collapse;margin:40px 0;font-size:14px;border:1px solid #D2D4D4;",
  "TH": "background:#EDF1EE;color:#4F6F52;font-weight:700;border:1px solid #D2D4D4;padding:12px 10px;text-align:left;",
  "TD": "border:1px solid #D2D4D4;padding:12px 10px;color:#555;background:#fff;"
}
