{
  "H1": "font-size:24px;font-weight:bold;color:#000;margin:40px 0 30px;text-align:center;line-height:1.4;",
  "H2": "font-size:20px;font-weight:bold;color:#333;margin:30px 0 20px;line-height:1.4;",
  "H3": "font-size:18px;font-weight:bold;color:#666;margin:25px 0 15px;line-height:1.4;",
  "H4": "font-size:16px;font-weight:bold;color:#666;margin:20px 0 10px;line-height:1.4;",
  "P": "margin:16px 0;line-height:1.7;text-align:justify;color:#333;font-size:16px;letter-spacing:0px;",
  "BLOCKQUOTE": "margin:16px 0;padding:16px 20px;background:#f5f5f5;border-left:4px solid #ddd;border-radius:4px;",
  "BLOCKQUOTE P": "margin:0;color:#666;font-size:15px;line-height:1.6;text-align:left;",
  "UL": "margin:16px 0;padding-left:25px;list-style-type:disc;",
  "OL": "margin:16px 0;padding-left:25px;list-style-type:decimal;",
  "LI": "margin:5px 0;color:#333;line-height:1.7;font-size:16px;",
  "A": "color:#1e6bb8;text-decoration:none;border-bottom:1px solid #1e6bb8;font-weight:bold;",
  "STRONG": "font-weight:bold;color:#000;",
  "EM": "font-style:italic;color:#333;",
  "DEL": "text-decoration:line-through;color:#999;",
  "CODE": "color:#e83e8c;background:#f8f9fa;padding:2px 6px;margin:0 2px;border-radius:3px;font-size:14px;font-family:'Courier New',Courier,monospace;",
  "PRE": "display:block;padding:16px;background:#f5f5f5;font-size:13px;line-height:1.7;border-radius:4px;font-family:'Courier New','Consolas','Monaco',monospace;overflow-x:auto;white-space:pre-wrap;word-break:break-all;border:1px solid #ddd;",
  "IMG": "display:block;margin:20px auto;max-width:100%;border-radius:4px;",
  "HR": "margin:30px 0;border:none;border-top:1px solid #ddd;height:1px;",
  "TABLE": "width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;",
  "TH": "background:#f5f5f5;color:#333;border:1px solid #ddd;padding:10px;font-weight:bold;text-align:left;",
  "TD": "border:1px solid #ddd;padding:10px;color:#333;"
}
