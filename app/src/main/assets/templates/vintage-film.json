{
  "H1": "border-top:4px double #B33D25;border-bottom:1px solid #B33D25;padding:20px 0;margin:60px 0 50px;text-align:center;font-size:26px;font-weight:900;color:#B33D25;line-height:1.2;letter-spacing:3px;font-family:'Songti SC','SimSun','STSong',Georgia,serif;",
  "H2": "margin:50px 0 30px;display:inline-block;font-size:19px;font-weight:bold;color:#FFFBF0;background-color:#B33D25;padding:8px 16px;border-radius:2px;box-shadow:4px 4px 0px rgba(179,61,37,0.2);line-height:1.2;",
  "H3": "margin:40px 0 20px;font-size:18px;font-weight:bold;color:#8D5B4C;display:inline-block;padding-left:10px;border-left:4px solid #D98C45;",
  "H4": "margin:30px 0 15px;text-align:left;display:inline-block;font-size:16px;font-weight:bold;color:#B33D25;border-bottom:2px solid #F2C94C;padding-bottom:2px;",
  "P": "margin:26px 0;line-height:1.9;letter-spacing:0.8px;text-align:justify;color:#5D4037;font-size:16px;",
  "BLOCKQUOTE": "margin:36px 0;padding:24px;background-color:#F7EED6;border-left:3px solid #8D5B4C;border-radius:2px;",
  "BLOCKQUOTE P": "margin:0;color:#6D4C41;font-size:15px;line-height:1.8;font-style:italic;",
  "UL": "margin:20px 0;padding-left:20px;list-style-type:square;color:#D98C45;",
  "OL": "margin:20px 0;padding-left:20px;list-style-type:decimal;color:#B33D25;font-weight:bold;font-family:serif;",
  "LI": "margin-bottom:12px;line-height:1.8;color:#5D4037;font-size:16px;font-weight:normal;",
  "A": "color:#B33D25;text-decoration:none;border-bottom:1px solid #B33D25;font-weight:bold;",
  "STRONG": "color:#B33D25;font-weight:900;margin:0 2px;",
  "EM": "color:#D98C45;font-style:italic;font-weight:bold;",
  "EM STRONG": "color:#B33D25;",
  "STRONG EM": "color:#B33D25;",
  "MARK": "background:rgba(242,201,76,0.3);color:#B33D25;padding:2px 4px;border-radius:2px;",
  "DEL": "text-decoration:line-through;color:#8D5B4C;",
  "CODE": "color:#5D4037;background:#EFE6D5;border:none;padding:2px 6px;margin:0 4px;border-radius:3px;font-size:14px;font-family:serif;",
  "PRE": "display:block;padding:20px;background:#4A3B32;color:#E6CBB5;font-size:13px;line-height:1.6;border-radius:4px;font-family:'Courier New',Courier,monospace;overflow-x:auto;white-space:pre-wrap;word-break:break-all;border:4px solid #F7EED6;",
  "IMG": "display:block;margin:40px auto;width:95%;border:8px solid #fff;box-shadow:0 10px 25px rgba(93,64,55,0.15);background:#fff;",
  "HR": "margin:60px auto;border:none;height:1px;border-top:2px dashed #D98C45;width:100%;",
  "TABLE": "width:100%;border-collapse:collapse;margin:40px 0;font-size:14px;border:2px solid #8D5B4C;",
  "TH": "background:#EFE6D5;color:#4A3B32;font-weight:bold;border:1px solid #8D5B4C;padding:12px 10px;text-align:center;",
  "TD": "border:1px solid #8D5B4C;padding:12px 10px;color:#5D4037;background:#FFFBF0;"
}
